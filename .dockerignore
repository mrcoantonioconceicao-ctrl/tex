# Contexto de build enxuto e reprodutível: nada gerado na máquina de quem builda.
.git
.github

# Saída do Rust (centenas de MB) e dependências/artefatos do Node:
# os node_modules do host têm binários nativos que não rodam no Alpine
target
**/node_modules
**/dist

# Variáveis locais nunca entram na imagem
**/.env*
!**/.env.example

# Fora da imagem do backend: o front tem Dockerfile próprio (contexto ./frontend)
# e a ingestão roda à parte
frontend
ingestion
docs
