# Variáveis da stack local (docker-compose.yml e Makefile).
# Para mudar algo: cp .env.example .env e edite o .env (que fica fora do git).
# Todos os valores abaixo já são os padrões: sem .env, tudo funciona igual.

# Portas no host
TEX_BACKEND_PORT=8080
TEX_FRONTEND_PORT=3000
TEX_DB_PORT=5433

# Banco local (só desenvolvimento; num ambiente real a senha vem de um segredo)
TEX_DB_USER=tex
TEX_DB_PASSWORD=tex
TEX_DB_NAME=tex

# true = build do front com os mocks MSW (o make up-mock já liga sozinho)
TEX_USE_MOCKS=false

# Só para rodar o backend fora do Docker (cargo run). No make up o compose já define.
# Sem DATABASE_URL o backend sobe sem banco e o /health mostra "database":"disabled".
# DATABASE_URL=postgres://tex:tex@localhost:5433/tex
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Fonte do /api/v1/investigations: synthetic (padrão até 14/11) ou database (lê
# experiments/experiment_files; exige DATABASE_URL). Valor desconhecido impede a subida.
# TEX_CATALOG_SOURCE=synthetic
