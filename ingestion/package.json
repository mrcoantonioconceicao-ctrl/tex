{
  "name": "tex-ingestion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Ingestão de dados públicos da NASA (NTRS) para o PostgreSQL do Tex Labs",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "ingest:ntrs": "node src/cli.ts",
    "db:migrate": "node src/migrate-cli.ts",
    "db:up": "docker compose -f ../docker-compose.yml up -d --wait db",
    "db:down": "docker compose -f ../docker-compose.yml stop db",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
